file_to_generate: "resp/v1/resp.proto"
proto_file: {
  name: "resp/v1/resp.proto"
  package: "resp.v1"
  message_type: {
    name: "DeleteRequest"
    field: {
      name: "id"
      number: 1
      label: LABEL_OPTIONAL
      type: TYPE_STRING
      json_name: "id"
    }
  }
  message_type: {
    name: "DeleteResponse"
  }
  message_type: {
    name: "CannotDeleteError"
    field: {
      name: "reason"
      number: 1
      label: LABEL_OPTIONAL
      type: TYPE_STRING
      json_name: "reason"
    }
  }
  message_type: {
    name: "NotFoundError"
    field: {
      name: "id"
      number: 1
      label: LABEL_OPTIONAL
      type: TYPE_STRING
      json_name: "id"
    }
  }
  message_type: {
    name: "GoneError"
  }
  service: {
    name: "FooService"
    method: {
      name: "Delete"
      input_type: ".resp.v1.DeleteRequest"
      output_type: ".resp.v1.DeleteResponse"
      options: {
        [google.api.http]: {
          delete: "/v1/foo/{id}"
        }
        [grpc.gateway.protoc_gen_openapiv3.options.openapiv3_operation]: {
          responses: {
            key: "404"
            value: {
              ref: "Missing"
            }
          }
          responses: {
            key: "409"
            value: {
              ref: "Conflict.v1"
            }
          }
          responses: {
            key: "400"
            value: {
              description: "Bad id."
            }
          }
        }
      }
    }
    method: {
      name: "Purge"
      input_type: ".resp.v1.DeleteRequest"
      output_type: ".resp.v1.DeleteResponse"
      options: {
        [google.api.http]: {
          post: "/v1/foo/{id}:purge"
        }
        [grpc.gateway.protoc_gen_openapiv3.options.openapiv3_operation]: {
          responses: {
            key: "default"
            value: {
              ref: "NotFound"
            }
          }
        }
      }
    }
  }
  options: {
    go_package: "github.com/example/resp/v1;respv1"
    [grpc.gateway.protoc_gen_openapiv3.options.openapiv3_document]: {
      components: {
        responses: {
          key: "NotFound"
          value: {
            description: "The foo does not exist."
            messages: "resp.v1.NotFoundError"
          }
        }
        responses: {
          key: "Conflict.v1"
          value: {
            description: "The foo is busy."
            messages: "resp.v1.CannotDeleteError"
            messages: "google.rpc.Status"
          }
        }
        responses: {
          key: "Gone"
          value: {
            description: "The foo was removed."
            messages: "resp.v1.GoneError"
          }
        }
      }
    }
  }
  syntax: "proto3"
}
